          "title": "阅读程序（2）",
          "description": "求数组 d 中的环数量（按 d 跳转的环）。",
          "lines": [
            "#include <cstdio>",
            "int n, d[100]; bool v[100];",
            "int main() {",
            "  scanf(\"%d\", &n);",
            "  for (int i = 0; i < n; ++i) { scanf(\"%d\", d + i); v[i] = false; }",
            "  int cnt = 0;",
            "  for (int i = 0; i < n; ++i) {",
            "    if (!v[i]) { for (int j = i; !v[j]; j = d[j]) v[j] = true; ++cnt; }",
            "  }",
            "  printf(\"%d\\n\", cnt);",
            "  return 0;",
            "}"
          ]
        },
        "questions": [
          {
            "id": "cr2",
            "type": "single",
            "question": "输入：10 7 1 4 3 2 5 9 8 0 6\n输出：",
            "options": [
              {
                "value": "A",
                "label": "3"
              },
              {
                "value": "B",
                "label": "4"
              },
              {
                "value": "C",
                "label": "5"
              },
              {
                "value": "D",
                "label": "6"
              }
            ],
            "answer": [
              "A"
