      "content": {
        "type": "quiz",
        "questions": [
          {
            "id": "ps1",
            "type": "single",
            "question": "1. 在 1 和 2015 之间, 不能被 4、5、6 任一个整除的数有 ______个。",
            "options": [
              {
                "value": "A",
                "label": "538"
              },
              {
                "value": "B",
                "label": "540"
              },
              {
                "value": "C",
                "label": "1075"
              },
              {
                "value": "D",
                "label": "1080"
              }
            ],
            "answer": [
              "C"
            ],
            "analysis": "容斥: 总 2015 - 能被 4-5-6 整除数. 4: 503, 5: 403, 6: 335, 4∩5(20): 100, 4∩6(12): 167, 5∩6(30): 67, 4∩5∩6(60): 33. 至少被 1 个整除 = 503+403+335-100-167-67+33 = 940. 不能 = 2015-940 = 1075. 选 C=1075。",
            "points": 5,
            "hasAnswer": true
          },
          {
            "id": "ps2",
            "type": "single",
            "question": "2. 结点数为 5 的不同形态二叉树有 ______种。",
            "options": [
              {
                "value": "A",
                "label": "14"
              },
              {
                "value": "B",
                "label": "24"
              },
              {
                "value": "C",
                "label": "42"
              },
              {
                "value": "D",
                "label": "48"
              }
            ],
            "answer": [
              "A"
            ],
            "analysis": "n 节点不同形态二叉树 = Catalan_{n-1} = C(2(n-1), n-1)/n = C(8,4)/5 = 70/5 = 14。n=5 即 C_4 = 14。→ A",
            "points": 5,
            "hasAnswer": true
          }
        ],
        "kind": "choice"
      },
