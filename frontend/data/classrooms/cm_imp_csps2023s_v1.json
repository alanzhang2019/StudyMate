              {
                "value": "C",
                "label": "deg[v] > 1"
              },
              {
                "value": "D",
                "label": "deg[v] > 0"
              }
            ],
            "answer": [
              "A"
            ],
            "analysis": "拓扑排序, v 的入度为 1 (即将变 0) 时入队。",
            "points": 3,
            "hasAnswer": true
          },
          {
            "id": "p1_3",
            "type": "single",
            "question": "填空(3): ③处应填（ ）。",
            "options": [
              {
                "value": "A",
                "label": "std::min(f[u] + f[v], LIM)"
              },
              {
                "value": "B",
                "label": "std::min(f[u] + f[v] + 1, LIM)"
              },
              {
                "value": "C",
                "label": "std::min(f[u] * f[v], LIM)"
              },
              {
                "value": "D",
                "label": "std::min(f[u] * (f[v] + 1), LIM)"
              }
            ],
            "answer": [
              "A"
            ],
            "analysis": "f[u] = min(1 + sum(f[v] for v in E[u]), LIM) 路径数累加。",
            "points": 3,
            "hasAnswer": true
          },
          {
            "id": "p1_4",
            "type": "single",
            "question": "填空(4): ④处应填（ ）。",
