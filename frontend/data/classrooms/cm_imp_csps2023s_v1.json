            "id": "p1_1",
            "type": "single",
            "question": "填空(1): ①处应填（ ）。",
            "options": [
              {
                "value": "A",
                "label": "k >= f[u]"
              },
              {
                "value": "B",
                "label": "k <= f[u]"
              },
