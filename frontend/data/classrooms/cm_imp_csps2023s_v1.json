                "label": "(long long)(j - mid) * (i - 1) * max"
              },
              {
                "value": "C",
                "label": "sum[j - mid]"
              },
              {
                "value": "D",
                "label": "sum[j - mid] * (i - 1)"
              }
            ],
            "answer": [
              "A"
