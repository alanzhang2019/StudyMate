      "title": "三、完善程序（2）分治求最大子段和（5 空 × 3 分 = 15 分）",
      "order": 6,
      "content": {
        "type": "quiz",
        "codeBlock": {
          "language": "cpp",
          "title": "完善程序（2）",
          "description": "分治 + 前后缀最大值求子段和。",
          "lines": [
            "#include <iostream>",
            "#include <algorithm>",
            "#include <vector>",
            "",
            "const int MAXN = 100000;",
            "",
            "int n;",
            "int a[MAXN];",
            "long long ans;",
            "",
            "void solve(int l, int r) {",
            "    if (l + 1 == r) {",
            "        ans += a[l];",
            "        return;",
            "    }",
            "    int mid = (l + r) >> 1;",
            "    std::vector<int> pre(a + mid, a + r);",
            "    for (int i = 1; i < r - mid; ++i) ①;",
            "    std::vector<long long> sum(r - mid + 1);",
            "    for (int i = 0; i < r - mid; ++i)",
            "        sum[i + 1] = sum[i] + pre[i];",
            "    for (int i = mid - l, j = mid, max = 0; i >= l; --i) {",
            "        while (j < r && ②) ++j;",
            "        max = std::max(max, a[i]);",
            "        ans += ③;",
            "        ans += ④;",
            "    }",
            "    solve(l, mid);",
            "    solve(mid, r);",
            "}",
            "",
            "int main() {",
            "    std::cin >> n;",
            "    for (int i = 0; i < n; ++i)",
            "        std::cin >> a[i];",
            "    ⑤;",
            "    std::cout << ans << std::endl;",
            "    return 0;",
            "}"
          ]
        },
        "questions": [
          {
            "id": "p2_1",
            "type": "single",
            "question": "填空(1): ①处应填（ ）。",
