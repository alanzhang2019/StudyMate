            "        if (a[j] <= i) {",
            "          ③;",
            "        }",
            "      }",
            "    }",
            "    if (trans & (1ull << (m - i))) {",
            "      cout << \"Win\" << endl;",
            "      return 0;",
            "    }",
            "    win = ~status & trans;",
            "    ④;",
            "    status = ⑤;",
            "  }",
            "  cout << \"Loss\" << endl;",
            "  return 0;",
            "}"
          ]
