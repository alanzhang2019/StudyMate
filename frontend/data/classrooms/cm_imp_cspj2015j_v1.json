        "codeBlock": {
          "language": "cpp",
          "title": "三、完善程序（2）中位数（每题 3 分，共 15 分）",
          "description": "给定 n（n 为奇数, 小于 1000）个整数，整数范围在 0~m（0<m<…）之间，用二分法求这 n 个整数的中位数。",
          "lines": [
            "#include <iostream>",
            "using namespace std;",
            "const int MAXN = 1000;",
            "int n, i, lbound, rbound, mid, m, count;",
            "int x[MAXN];",
            "int main() {",
            "  cin >> n >> m;",
            "  for (i = 0; i < n; i++)",
            "    cin >> x[i];",
            "  lbound = 0;",
            "  rbound = m;",
            "  while (①) {",
            "    mid = (lbound + rbound) / 2;",
            "    ②;",
            "    for (i = 0; i < n; i++)",
            "      if (③)",
            "        ④;",
            "    if (count > n / 2)",
            "      lbound = mid + 1;",
            "    else",
            "      ⑤;",
            "  }",
            "  cout << rbound << endl;",
            "  return 0;",
            "}"
          ]
        },
        "questions": [
          {
            "id": "p2_1",
            "type": "single",
            "question": "32. ① 处应填（ ）。",
            "options": [
              {
                "value": "A",
                "label": "lbound + 1 < rbound"
              },
              {
                "value": "B",
                "label": "lbound < rbound"
              },
              {
                "value": "C",
                "label": "lbound <= rbound"
              },
              {
                "value": "D",
                "label": "lbound <= rbound + 1"
              }
            ],
            "answer": [
              "B"
            ],
            "analysis": "二分条件 lbound < rbound；不满足时已找到答案。",
            "hasAnswer": true,
            "points": 3
          },
