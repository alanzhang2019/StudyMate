                "value": "A",
                "label": "count = 0"
              },
              {
                "value": "B",
                "label": "count = mid"
              },
              {
                "value": "C",
                "label": "count = n"
              },
              {
                "value": "D",
                "label": "count = count + 1"
              }
            ],
            "answer": [
              "A"
            ],
            "analysis": "每轮二分都要重置 count=0，重新统计 <= mid 的元素个数。",
            "hasAnswer": true,
            "points": 3
          },
