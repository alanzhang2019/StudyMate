            "#include <algorithm>",
            "#include <cstdio>",
            "#include <cstring>",
            "bool flag[27];",
            "int n;",
            "int p[27];",
            "int ans = 0;",
            "void dfs(int k) {",
            "    if (k == n + 1) {",
            "        ++ans;",
            "        return;",
            "    }",
