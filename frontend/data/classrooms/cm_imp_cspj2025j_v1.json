        "codeBlock": {
          "language": "cpp",
          "title": "阅读程序（1）：三元组互质计数",
          "description": "统计满足 1≤i<j<k≤n 且三者两两互质的三元组 (i, j, k) 的数量。",
          "startLine": 1,
          "lines": [
            "#include <algorithm>",
            "#include <cstdio>",
            "#include <cstring>",
            "using namespace std;",
            "inline int gcd(int a, int b) {",
            "    if (b == 0) return a;",
            "    return gcd(b, a % b);",
            "}",
            "int main() {",
            "    int n;",
            "    scanf(\"%d\", &n);",
            "    int ans = 0;",
            "    for (int i = 1; i <= n; ++i) {",
            "        for (int j = i + 1; j <= n; ++j) {",
            "            for (int k = j + 1; k <= n; ++k) {",
            "                if (gcd(i, j) == 1 && gcd(j, k) == 1",
