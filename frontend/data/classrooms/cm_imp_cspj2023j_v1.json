                "value": "D",
                "label": "22222211₈"
              }
            ],
            "answer": [
              "D"
            ],
            "analysis": "按八进制逢八进一逐位相加：个位 0+1=1，十位 7+2=11 写 1 进 1，百位 6+3+1=12 写 2 进 1，以此类推，结果为 22222211₈。",
            "points": 2,
            "hasAnswer": true
