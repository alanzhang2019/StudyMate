          "description": "用动态规划计算将 str1 转换为 str2 的最少操作次数，每次可删除、插入、替换一个字符。",
          "startLine": 1,
          "lines": [
            "#include <iostream>",
            "#include <string>",
            "#include <vector>",
            "using namespace std;",
            "int min3(int x, int y, int z) {",
            "  return min(min(x, y), z);",
            "}",
            "int edit_dist_dp(string str1, string str2) {",
            "  int m = str1.length();",
            "  int n = str2.length();",
            "  vector<vector<int>> dp(m+1, vector<int>(n+1));",
            "  for (int i = 0; i <= m; i++) {",
            "    for (int j = 0; j <= n; j++) {",
            "      if (i == 0)",
            "        dp[i][j] = ①;",
            "      else",
            "      if (j == 0)",
            "        dp[i][j] = ②;",
            "      else",
            "      if (③)",
            "        dp[i][j] = ④;",
            "      else",
            "        dp[i][j] = 1 + min3(dp[i][j-1], dp[i-1][j], ⑤);",
            "    }",
            "  }",
            "  return dp[m][n];",
            "}",
            "int main() {",
            "  string str1, str2;",
            "  cin >> str1 >> str2;",
            "  cout << \"Minimum number of operation: \" << edit_dist_dp(str1, str2) << endl;",
            "  return 0;",
