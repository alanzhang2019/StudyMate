            "unsigned a[maxn], b[maxn], res[maxn], ord[maxn];",
            "unsigned cnt[maxs + 1];",
            "int main() {",
            "  scanf(\"%d\", &n);",
            "  for (int i = 0; i < n; ++i)",
            "    scanf(\"%d%d\", &a[i], &b[i]);",
            "  memset(cnt, 0, sizeof(cnt));",
            "  for (int i = 0; i < n; ++i)",
            "    ①;",
            "  // 利用 cnt 数组统计数量",
            "  for (int i = 0; i < maxs; ++i)",
            "    cnt[i + 1] += cnt[i];",
            "  for (int i = 0; i < n; ++i)",
