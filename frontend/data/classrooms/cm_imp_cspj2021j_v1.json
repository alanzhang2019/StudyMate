            "int a[N],b[N],c[N],d[N];",
            "int f[N],g[N];",
            "void init() {",
            "  f[1]=g[1]=1;",
            "  for(int i=2;i<=n;i++) {",
            "    if(!a[i]) {",
            "      b[m++]=i;",
            "      c[i]=1,f[i]=2;",
