          "description": "反转数组。",
          "lines": [
            "#include <iostream>",
            "using namespace std;",
            "int main() {",
            "  int a[6] = {",
            "    1, 2, 3, 4, 5, 6",
            "  };",
            "  int pi = 0;",
            "  int pj = 5;",
            "  int t, i;",
            "  while (pi < pj) {",
            "    t = a[pi];",
            "    a[pi] = a[pj];",
            "    a[pj] = t;",
            "    pi++;",
            "    pj--;",
            "  }",
            "  for (i = 0; i < 6; i++)",
            "    cout << a[i] << ',';",
            "  cout << endl;",
            "  return 0;",
            "}"
          ]
        },
        "questions": [
          {
            "id": "cr1",
            "type": "single",
            "question": "输出：",
            "options": [
              {
                "value": "A",
                "label": "1,2,3,4,5,6,"
              },
              {
                "value": "B",
                "label": "6,5,4,3,2,1,"
              },
              {
                "value": "C",
                "label": "6,5,4,5,6,"
              },
              {
                "value": "D",
                "label": "4,3,2,1,5,6,"
              }
            ],
            "answer": [
              "B"
            ],
            "analysis": "while 循环每次交换 pi 和 pj 位置的元素后 pi++ pj--，相当于数组反转。原始数组 {1,2,3,4,5,6} 反转后为 {6,5,4,3,2,1}，输出 '6,5,4,3,2,1,'。",
            "codeLines": [
              "#include <iostream>",
              "using namespace std;",
              "int main() {",
              "  int a[6] = {1, 2, 3, 4, 5, 6};",
              "  int pi = 0; int pj = 5;",
              "  int t, i;",
              "  while (pi < pj) {",
              "    t = a[pi]; a[pi] = a[pj]; a[pj] = t;",
              "    pi++; pj--;",
              "  }",
              "  for (i = 0; i < 6; i++) cout << a[i] << ',';",
              "  cout << endl;",
              "  return 0;",
              "}"
            ],
