// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  educationStage String? // primary, junior_high, senior_high, university
  enrollmentYear Int?

  role      String   @default("user") // "admin" or "user"
  isActive  Boolean  @default(true)   // 用户是否启用

  errorItems ErrorItem[]
  subjects   Subject[]
  practiceRecords PracticeRecord[]
  customTags KnowledgeTag[] // User's custom tags
  videoJobs  VideoJob[]  // 错题视频讲解任务
  paperScans PaperScan[] // 拍整张卷子的记录（批次 WNPAPER）
}

// 统一知识点标签表 (支持无限层级)
model KnowledgeTag {
  id        String   @id @default(cuid())
  name      String   // 标签名，如 "勾股定理"
  subject   String   // 学科，如 "math", "english"

  // 层级控制 (邻接表模式)
  parentId  String?
  parent    KnowledgeTag?  @relation("TagHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children  KnowledgeTag[] @relation("TagHierarchy")

  // 排序与编码
  order     Int      @default(0) // 用于保持教材顺序
  code      String?              // 如 "1.2.1"

  // 区分系统预设 vs 用户自定义
  isSystem  Boolean  @default(false)
  userId    String?  // 如果是用户自定义标签，绑定 userId
  user      User?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  // 与错题的多对多关系
  errorItems ErrorItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // 联合索引：确保同一用户（或系统）下同一父节点下的标签名不重复
  @@unique([subject, name, userId, parentId])
  // 索引：加速父子查询
  @@index([parentId])
  @@index([subject])
}

model Subject {
  id     String @id @default(cuid())
  name   String
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  errorItems ErrorItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([name, userId])
}

model ErrorItem {
  id             String   @id @default(cuid())
  userId         String
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  subjectId      String?
  subject        Subject? @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  
  originalImageUrl String
  ocrText          String?
  
  // AI Analysis
  questionText     String? // Parsed question
  answerText       String? // AI provided answer
  analysis         String? // AI analysis/explanation
  wrongAnswerText  String? // Student's wrong answer/work if visible
  mistakeAnalysis  String? // Analysis of why the wrong answer happened
  mistakeStatus    String? // not_attempted, wrong_attempt, unknown
  knowledgePoints  String? // [DEPRECATED] JSON string - kept for migration only
  geogebraCommands String? // GeoGebra commands for interactive demo (JSON or newline-separated)

  // New: many-to-many relation with KnowledgeTag
  tags             KnowledgeTag[]
  
  // User Metadata
  source           String? // e.g. "Midterm Exam"
  errorType        String? // e.g. "Calculation", "Concept"
  userNotes        String?
  
  masteryLevel     Int     @default(0) // 0: New, 1: Reviewing, 2: Mastered
  gradeSemester    String? // e.g. "Junior High Grade 2, 1st Semester"
  paperLevel       String? // e.g. "A", "B", "Other"
  
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  // 批次210-D：外部系统（hl-platform）推送过来的错题用它做幂等键。
  // 本应用自己建的错题一律为 null（老数据也全是 null），互不干扰。
  // ★ 唯一索引是 (userId, externalId) 而不是单列 externalId：
  //   不同学生的 externalId 完全可能撞（都是「数学|unit1|q3」），
  //   单列唯一会让第二个学生推不进来。
  externalId       String?

  // ★ 2026-11-12「拍整张卷子」：这条错题是从哪张卷子的第几页来的。
  //   两个都是可空的 —— 老数据、单题拍照进来的条目保持 NULL，行为一个字都不变。
  //   ★ 故意**不**声明 relation：SQLite 加外键要重建整张表，而这里只需要"指回原卷"，
  //     真正的级联由 /api/paper-scans 手工维护（删卷子时连带删条目）。
  paperScanId      String?
  paperPageNo      Int?

  reviewSchedules ReviewSchedule[]
  videoJobs       VideoJob[]

  @@unique([userId, externalId])
  @@index([paperScanId])
}

/// 拍整张卷子的一次记录：一张卷子一行，下面挂 1..6 张页图。
model PaperScan {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  subjectId     String? // 归属本子（Subject）
  title         String? // 卷面标题，如「第四单元测评」
  gradeSemester String?
  paperLevel    String?
  pageCount     Int     @default(0)

  pages PaperPage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}

/// 卷子的整页原图。★ 一页只存一份 —— 同一页上的 8 道错题都指回这一行，
/// 不像单题拍照那样每题存一份整页图（那是把库撑爆的最快办法）。
model PaperPage {
  id     String @id @default(cuid())
  scanId String
  scan   PaperScan @relation(fields: [scanId], references: [id], onDelete: Cascade)

  pageNo   Int // 1 起
  imageUrl String // data URL（base64）
  width    Int?
  height   Int?

  createdAt DateTime @default(now())

  @@unique([scanId, pageNo])
  @@index([scanId])
}

model ReviewSchedule {
  id          String    @id @default(cuid())
  errorItemId String
  errorItem   ErrorItem @relation(fields: [errorItemId], references: [id], onDelete: Cascade)
  
  scheduledFor DateTime
  completedAt  DateTime?
  isCorrect    Boolean? // Result of the review
  
  createdAt    DateTime @default(now())
}

model PracticeRecord {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  subject   String?  // e.g. "Math", "Physics"
  difficulty String? // "easy", "medium", "hard", "harder"
  isCorrect Boolean?
  
  createdAt DateTime @default(now())
}

// 错题视频讲解任务（2026-10-24）：错题本 ←→ videoclass 的映射。
// ★ 为什么需要这张表：videoclass 建题无查重（每次 POST /problems 都建新题），
//   只有 job 层按 (user_id, Idempotency-Key) 幂等。不记映射，学生点第二次
//   「视频讲解」就会重复建题、重复烧一次 LLM+渲染。
// ★ (userId, errorItemId) 唯一：一个学生的一道错题只有一个任务行；
//   失败后重新生成是原地更新这一行（vtJobId 换成新 job），不堆历史。
// ★ 删错题级联删任务（onDelete: Cascade），与 ErrorItem 其他从表一致。
model VideoJob {
  id          String  @id @default(cuid())
  userId      String
  user        User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  errorItemId String
  errorItem   ErrorItem @relation(fields: [errorItemId], references: [id], onDelete: Cascade)

  vtProblemId Int // videoclass 侧题目 id
  vtJobId     Int // videoclass 侧任务 id（Idempotency-Key = wn:{errorItemId}）
  vtVideoId   Int? // 出片后回填的 videoclass 视频 id

  // created/queued/storyboarding/rendering/composing/published/failed/cancelled
  state        String    @default("created")
  progress     Int       @default(0)
  errorCode    String?
  errorMessage String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, errorItemId])
  @@index([errorItemId])
}
